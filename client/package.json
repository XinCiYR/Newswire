{
  "name": "news-aggregator-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Frontend: React SPA (bundled with esbuild CLI) for the news aggregator.",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --format=esm --loader:.jsx=jsx --loader:.woff2=file --loader:.woff=file --loader:.ttf=file --jsx=automatic --target=es2020 --outdir=dist/assets --public-path=/assets --entry-names=[name]-[hash] && node scripts/copy-index.mjs",
    "dev": "node ../server/src/index.js",
    "smoke:test": "npm run build && node scripts/smoke-test.mjs",
    "test": "esbuild test/ui.test.jsx --bundle --platform=node --format=esm --packages=external --jsx=automatic --outfile=.test-build/ui.test.mjs && node --test test/*.test.mjs .test-build/ui.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "jsdom": "^30.0.1"
  },
  "engines": { "node": ">=24.0.0 <25" }
}
